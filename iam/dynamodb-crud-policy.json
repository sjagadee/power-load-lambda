{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBItemCrud",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/lambda-apigateway"
    }
  ]
}

{
  "info": {
    "name": "Serverless CRUD - Power & Load",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_url",
      "value": "https://<API_ID>.execute-api.<REGION>.amazonaws.com/prod/DynamoDBManager"
    }
  ],
  "item": [

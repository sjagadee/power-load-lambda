      "name": "load test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation\": \"list\",\n  \"tableName\": \"lambda-apigateway\",\n  \"payload\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api_url}}",
          "host": [
            "{{api_url}}"
          ]
        }
      }
    },
